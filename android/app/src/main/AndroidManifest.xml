<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Requested during onboarding, and never at launch. Each is explained on the
      step it belongs to before the system dialog is shown.

      Coarse accompanies fine because Android 12 and above let the user grant
      only the approximate one; declaring fine alone means that choice cannot be
      offered and the grant silently fails.

      POST_NOTIFICATIONS is Android 13+. Older versions grant notifications at
      install and ignore this, which is why there is no maxSdkVersion here. With
      push on (phase5-contract.md section 6.3) it is also asked for once after
      the first sign in, unless onboarding already asked - never at launch, and
      never again after a refusal (shared/services/pushRegistration.ts).
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      The camera is used to photograph a problem, not to inspect the device. A
      phone without one must still be able to install and run the app.

      Because CAMERA is declared above, Android refuses the camera to the app
      until it is granted, so ApiImageService asks for it (PermissionService)
      every time before opening the camera. Choosing from the library needs no
      permission at all: react-native-image-picker opens the system photo
      picker, which hands over only the photos the person chose. READ_MEDIA_IMAGES
      and READ_EXTERNAL_STORAGE are deliberately absent - whole-library access is
      more than the app needs, and Play restricts it to apps that do (Phase 4B).
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!--
        Push notifications (phase5-contract.md section 6, owner-approved
        28/11/2026). Inert until android/app/google-services.json is added: with
        no Firebase app, nothing is delivered and these are never read.

        The channel is the one the backend names on every message
        (`android.notification.channelId: "fixora-default"`); this makes it the
        default too, for a message that names none. MainApplication creates it at
        start-up, so it exists before the first message arrives. React Native
        Firebase declares the same key with an empty value from firebase.json,
        hence tools:replace.

        The small icon is a white bell on transparent (drawable/ic_notification):
        Android draws the status-bar icon from the alpha channel alone, so the
        full-colour launcher icon would show as a white square.

        ⚠️ The channel id is written in three places that must agree: here,
        MainApplication.kt and the backend's push service.
      -->
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_channel_id"
        android:value="@string/notification_channel_default_id"
        tools:replace="android:value" />
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_icon"
        android:resource="@drawable/ic_notification" />
    </application>
</manifest>
