<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon, used from API 26 onward.

  The launcher supplies the mask, so the mark must not draw its own tile here:
  the background is the brand gradient and the foreground is the glyph alone,
  inset into the 72dp safe zone. A pre-tiled square would be cropped twice and
  lose its corners.

  `monochrome` lets a themed launcher tint the glyph. It reuses the foreground
  because that layer is already white-on-transparent, which is exactly what a
  tintable icon needs.

  The PNG mipmaps remain for API 24 and 25, which this project still supports.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
