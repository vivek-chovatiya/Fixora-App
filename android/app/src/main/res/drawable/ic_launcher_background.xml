<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive icon's background layer.

  A gradient rather than a flat fill, because the master artwork's tile is one:
  a flat plate under the same glyph reads as a different, duller icon beside it.
  The two stops are sampled from the master, so the adaptive icon and the legacy
  PNG land on the same blue.

  No corner radius here on purpose. The launcher supplies the mask, and a shape
  that rounded itself would be rounded twice.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#0193FE"
        android:endColor="#0138DF"
        android:type="linear" />
</shape>
